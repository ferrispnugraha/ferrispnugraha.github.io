{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "allow",
      "conda *": "ask",
      "pip install *": "ask",
      "pip uninstall *": "ask",
      "bundle install": "ask",
      "bundle update": "ask",
      "apt-get *": "ask",
      "apt *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "rm -rf *": "ask",
      "docker *": "ask",
      "npm install -g *": "ask",
      "gem install *": "ask"
    },
    "external_directory": {
      "*": "allow"
    }
  }
}
